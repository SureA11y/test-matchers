{
  "name": "@surea11y/test-matchers",
  "version": "1.2.0",
  "description": "Fail Jest and Vitest tests on accessibility (a11y, WCAG) violations: expect(container).toHaveNoA11yViolations() for React, Vue, Angular, Svelte or plain DOM component tests in jsdom.",
  "keywords": [
    "accessibility",
    "a11y",
    "a11y-testing",
    "wcag",
    "wcag21",
    "wcag22",
    "en301549",
    "en-301-549",
    "european-accessibility-act",
    "aria",
    "accessibility-testing",
    "unit-testing",
    "jest",
    "vitest",
    "jest-matchers",
    "vitest-matchers",
    "custom-matchers",
    "expect",
    "testing-library",
    "react-testing-library",
    "react",
    "vue",
    "angular",
    "svelte",
    "component-testing",
    "jsdom",
    "surea11y"
  ],
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "author": "Jorge Rumoroso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SureA11y/test-matchers.git"
  },
  "homepage": "https://github.com/SureA11y/test-matchers#readme",
  "bugs": {
    "url": "https://github.com/SureA11y/test-matchers/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@surea11y/binding-base": "^1.3.1",
    "@surea11y/core": "^1.11.1"
  },
  "peerDependencies": {
    "jest": ">=27.0.0",
    "vitest": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "npm run test:jest && npm run test:vitest",
    "test:jest": "jest",
    "test:vitest": "vitest run"
  }
}
